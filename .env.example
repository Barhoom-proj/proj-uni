# Copy to .env.local and fill in your real Cognito values.
# Both IDs must be provided to enable real sign-in.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=

# Configure only AFTER you have deployed authenticated API Gateway + Lambda routes.
# Example: https://abcdef.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=
